rules_version = '2';

// Modelo de la app:
// - Lista global de emails autorizados en config/access.allowedEmails.
// - Perfil en usuarios/{uid} (nunca guarda contraseñas).
// - Índice de acceso en acceso/{email} (solo indica si ya tiene contraseña).
// - Cada cuenta tiene su propia casa en households/{uid} y sus gastos en
//   households/{uid}/gastos. No se comparten gastos entre cuentas.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function accessConfig() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    // Solo los emails de la lista pueden usar la app y tocar datos.
    // La autorización se define exclusivamente por esta lista; no se usan
    // proveedores externos ni verificación de email.
    function isAllowedEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in accessConfig().allowedEmails;
    }

    function isHouseholdOwner(householdId) {
      return isAllowedEmail()
        && request.auth.uid == householdId;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function isValidGasto(data) {
      return data.monto is number
        && data.monto > 0
        && data.categoria is string
        && data.categoria.size() > 0
        && data.categoria.size() <= 100
        && data.tipoOperacion is string
        && data.tipoOperacion in ['entrada', 'salida']
        && data.fecha is timestamp
        && data.fechaRegistro is timestamp
        && data.usuario is string
        && data.usuario.size() > 0
        && data.usuario.size() <= 100
        && data.usuarioUid == request.auth.uid
        && data.usuarioEmail is string
        && data.usuarioEmail.lower() == request.auth.token.email.lower();
    }

    // La lista de acceso se administra desde Firebase Console.
    // Se permite leer ese documento puntual antes del login para validar el
    // correo. Solo contiene emails; no se puede listar la colección ni escribir.
    match /config/access {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Perfil del usuario. La contraseña NUNCA se guarda en Firestore:
    // Firebase Authentication la almacena hasheada y no es legible.
    match /usuarios/{uid} {
      allow read, write: if isAllowedEmail()
        && request.auth.uid == uid;
    }

    // Índice mínimo para saber, antes del login, si un correo ya tiene
    // contraseña. No guarda contraseñas ni hashes; solo el estado.
    // Se puede leer puntualmente, pero no listar.
    match /acceso/{email} {
      allow get: if true;
      allow list: if false;
      allow write: if isAllowedEmail()
        && request.auth.token.email.lower() == email
        && request.resource.data.email is string
        && request.resource.data.email.lower() == email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.passwordSet == true
        && request.resource.data.updatedAt is timestamp;
    }

    match /households/{householdId} {
      // Cada usuario solo puede leer/crear su propia casa (ID = UID).
      allow read: if isHouseholdOwner(householdId);

      allow create: if isHouseholdOwner(householdId)
        && !exists(householdPath(householdId))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerEmail == request.auth.token.email.lower()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt is timestamp;

      // Solo se permite cambiar el nombre de la casa.
      allow update: if isHouseholdOwner(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;

      match /gastos/{gastoId} {
        allow read, delete: if isHouseholdOwner(householdId);
        allow create, update: if isHouseholdOwner(householdId)
          && isValidGasto(request.resource.data);
      }
    }

    // Todo lo que no esté explícitamente permitido queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
